{
  "name": "gh-api-client",
  "version": "1.16.3",
  "description": "A lightweight Java client for the GitHub API that simplifies common operations such as listing repositories, branches, commits, collaborators, and files, with built-in support for token-based authentication.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "docs": "typedoc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:performance": "jest --config jest.performance.config.ts --runInBand",
    "test:coverage": "jest --coverage",
    "test:client": "npm run build && node test-client/test.js",
    "bench:throughput": "jest --config jest.performance.config.ts --runInBand --testPathPattern=throughput",
    "bench:concurrent": "jest --config jest.performance.config.ts --runInBand --testPathPattern=concurrent",
    "bench:all": "jest --config jest.performance.config.ts --runInBand",
    "bench:heap": "TS_NODE_PROJECT=tsconfig.benchmark-node.json node --expose-gc --loader ts-node/esm --no-warnings benchmarks/heap-pressure.ts",
    "bench:eventloop": "TS_NODE_PROJECT=tsconfig.benchmark-node.json node --loader ts-node/esm --no-warnings benchmarks/event-loop-lag.ts",
    "bench": "npm run bench:all && npm run bench:heap && npm run bench:eventloop"
  },
  "keywords": [
    "github",
    "api",
    "client",
    "repositories",
    "branches",
    "commits",
    "collaborators",
    "files",
    "pull requests",
    "github api client",
    "github api wrapper",
    "github api library",
    "git trees"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ElJijuna/github-api-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElJijuna/github-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/ElJijuna/github-api-client/issues"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.3",
    "super-configs": "^1.0.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.3"
  }
}
